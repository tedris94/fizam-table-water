# Phusion Passenger / Apache config for Namecheap Stellar (single Node app slot).
# This file lives at the cPanel application root.

PassengerNodejs /home/CPANEL_USER/.nvm/versions/node/v20.20.2/bin/node
PassengerStartupFile app.js

# Force HTTPS (uncomment after your SSL cert is issued)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Long-lived cache for Next.js static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|mjs|css|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Block direct access to sensitive directories
<IfModule mod_alias.c>
  RedirectMatch 404 /\.next/
  RedirectMatch 404 /node_modules/
  RedirectMatch 404 /data/
  RedirectMatch 404 /\.env
</IfModule>
