# --- Required ---

# Long random string used to sign cookies & JWTs. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite connection string. Defaults to ./data/fizam.db when omitted.
# Format: file:absolute-or-relative-posix-path
DATABASE_URI=file:./data/fizam.db

# Public URL of the site (used for Paystack callbacks and admin server URL).
# Production: use https://www.fizam.ng (matches Vercel www redirect for WhatsApp/OG crawlers)
# Local dev: keep https://fizam.ng here if you like; payload.config.ts whitelists localhost for CSRF.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Facebook App ID for Sharing Debugger (create at https://developers.facebook.com/apps/)
# NEXT_PUBLIC_FACEBOOK_APP_ID=

# --- Paystack ---

# Get test keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# --- SMTP (Namecheap mailbox or any provider) ---

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@fizam.ng
SMTP_PASS=app-or-mailbox-password
SMTP_FROM="Fizam Table Water <noreply@fizam.ng>"
# Optional overrides (same SMTP login; most hosts allow sending as these if the addresses exist on the domain):
# SMTP_FROM_ORDERS="Fizam Sales <sales@fizam.ng>"
# SMTP_FROM_INTERNAL="Fizam Website <noreply@fizam.ng>"

# Where contact-form messages are emailed.
CONTACT_NOTIFY_EMAIL=hello@fizam.ng

# Where new paid orders are emailed (internal alert). Falls back to CONTACT_NOTIFY_EMAIL.
# ORDERS_NOTIFY_EMAIL=sales@fizam.ng

# Reply-to line in customer order emails (defaults to ORDERS_NOTIFY_EMAIL or sales@).
# ORDERS_REPLY_EMAIL=sales@fizam.ng

# Where new job applications are emailed (internal alert).
HR_NOTIFY_EMAIL=hr@fizam.ng

# Applicant-facing careers emails (From header). Use a real mailbox on fizam.ng.
SMTP_FROM_CAREERS="Fizam Careers <sales@fizam.ng>"

# Reply-to / contact line in applicant emails (defaults to HR_NOTIFY_EMAIL).
# CAREERS_REPLY_EMAIL=hr@fizam.ng

# --- Optional ---

# Paystack callback override; default is `${NEXT_PUBLIC_SITE_URL}/order/success`
# PAYSTACK_CALLBACK_URL=https://fizam.ng/order/success

# Secret key required to access /api/diagnostics/email. Leave blank in production
# to disable diagnostics entirely. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Then call:  /api/diagnostics/email?key=<value>  or send the
# `x-diagnostics-key: <value>` header.
DIAGNOSTICS_KEY=
